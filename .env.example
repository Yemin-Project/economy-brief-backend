# Create a local .env file from this template and add your API key.
# Docker Compose PostgreSQL settings. Change the password outside local development.
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
OPENAI_API_KEY=api-key-text-here
OPENAI_MODEL=ai-model-name-here
LOG_LEVEL=INFO
